# Kernel config additions for Proxmox VE / LXC on whyred (SDM636).
# Applied on top of arm64 defconfig via scripts/kconfig/merge_config.sh
# or `cat fragment >> .config && make olddefconfig`.

# ---- containers / namespaces ----
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y

# ---- overlay / fs for containers & images ----
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# ---- networking (bridges, veth, filters) ----
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_FILTER=y
CONFIG_VLAN_8021Q=y
CONFIG_TUN=y

# ---- misc LXC/PVE requirements (lxc-checkconfig) ----
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_SECCOMP=y
CONFIG_SECURITY_APPARMOR=y

# ---- whyred platform essentials ----
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SCM=y
CONFIG_MAILBOX=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_ETH=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_DRM_SIMPLE_DRM=y
CONFIG_FB_SIMPLE=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_PWM_SUN4I=n
